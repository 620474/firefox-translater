{
  "manifest_version": 2,
  "name": "AI Article Reader",
  "version": "0.1.0",
  "description": "Перевод статей и суммаризация через собственные API Gemini, DeepSeek и OpenAI.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "unlimitedStorage",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "AI Article Reader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "reader-core.js",
        "content.js",
        "floating.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-translator@620474.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
